# Copy to backend/.env and fill in. Never commit the real .env.

ENVIRONMENT=local
DEBUG=true

# --- Database --------------------------------------------------------------
# MUST be the api_user role, not postgres. Connecting as a superuser silently
# bypasses every RLS policy — the API refuses to start in production if you do.
# Set the password once against your local stack:
#   psql "$ADMIN_DATABASE_URL" -c "alter role api_user with password 'api_password'"
DATABASE_URL=postgresql+asyncpg://api_user:api_password@127.0.0.1:54322/postgres

# Privileged connection for migrations and background workers only.
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# `supabase status` prints these for the local stack.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Frontend origins ------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Business rules (docs/DECISIONS.md) ------------------------------------
GATE_APPROVAL_SLA_MINUTES=15
GATE_ESCALATION_MINUTES=30
ID_PHOTO_REVALIDATION_DAYS=180
SIGNED_URL_TTL_SECONDS=300
SCAN_BACKDATE_TOLERANCE_HOURS=24

# --- Email -----------------------------------------------------------------
# Local Supabase runs Inbucket on :54324 — mail lands there, nothing is sent out.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=warehouse@reward360.local
SUPERADMIN_EMAIL=superadmin@reward360.local
